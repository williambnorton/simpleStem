# Audio data — large, shared via Google Drive, not in git
STEMS/
M4A/
_quarantine_dupes/

# CATALOG.json is generated by catalog.py on the Librarian. Tracking it
# in git causes sync_to_drive.sh to overwrite the canonical Drive copy
# with stale legacy-shape data, triggering [catalog] DRIFT warnings until
# the next catalog.py run rewrites it. (BUG-6, 2026-06-30.)
CATALOG.json

